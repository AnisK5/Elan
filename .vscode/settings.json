{
  "files.exclude": {
    ".claude": true,
    ".next": true,
    ".vercel": true,
    "node_modules": true,
    "next-env.d.ts": true,
    "**/*.tsbuildinfo": true,
    "package-lock.json": true,
    "postcss.config.mjs": true,
    "next.config.ts": true,
    "tsconfig.json": true,
    "eslint.config.mjs": true,
    "vitest.config.ts": true,
    ".gitignore": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, postcss.config.mjs, next.config.ts, tsconfig.json, eslint.config.mjs, vitest.config.ts, .env.local.example",
    "README.md": "AGENTS.md, CLAUDE.md"
  }
}
